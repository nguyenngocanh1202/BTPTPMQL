@model DemoMVC.Models.SubjectScore

@{
    ViewData["Title"] = "Tính điểm môn học";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Index" method="post">
    <div class="form-group">
        <label for="ScoreA">Điểm thành phần A:</label>
        <input type="text" class="form-control" id="ScoreA" name="ScoreA" asp-for="ScoreA" />
    </div>
    <div class="form-group">
        <label for="ScoreB">Điểm thành phần B:</label>
        <input type="text" class="form-control" id="ScoreB" name="ScoreB" asp-for="ScoreB" />
    </div>
    <div class="form-group">
        <label for="ScoreC">Điểm thành phần C:</label>
        <input type="text" class="form-control" id="ScoreC" name="ScoreC" asp-for="ScoreC" />
    </div>
    <button type="submit" class="btn btn-success">Tính điểm</button>
</form>

@if (ViewBag.infoScore != null)
{
    <div class="alert alert-info mt-3">
        @ViewBag.infoScore
    </div>
}